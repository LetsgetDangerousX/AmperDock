<Window x:Class="AmperDock.App.Settings.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dock appearance" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Sans}" FontSize="{StaticResource Type.Body.Size}"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}">
  <!-- S14 (Appearance), first slice: shape, colour, transparency. Changes show on the dock as you make them. -->
  <DockPanel>
    <!-- sticky footer -->
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}"
            Background="{DynamicResource Brush.Surface}" Padding="24,12">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Ghost}" Content="Reset to default" Click="OnReset"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Btn.Secondary}" Content="Cancel" IsCancel="True" Click="OnCancel" Margin="0,0,8,0"/>
          <Button Style="{StaticResource Btn.Primary}" Content="Save" IsDefault="True" Click="OnSave"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel Margin="24,20,24,24">
      <TextBlock Style="{StaticResource Text.Title}" Text="Dock appearance"/>
      <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0" Text="Changes show on your dock right away. Save keeps them."/>

      <!-- Shape -->
      <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,24,0,8" Text="Corners"/>
      <UniformGrid Rows="1" Columns="4" x:Name="ShapePresets">
        <RadioButton GroupName="shape" Content="Sharp" Tag="0" Checked="OnShapePreset"/>
        <RadioButton GroupName="shape" Content="Soft" Tag="0.2" Checked="OnShapePreset"/>
        <RadioButton GroupName="shape" Content="Rounded" Tag="0.5" Checked="OnShapePreset"/>
        <RadioButton GroupName="shape" Content="Pill" Tag="1" Checked="OnShapePreset"/>
      </UniformGrid>
      <DockPanel Margin="0,8,0,0">
        <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Text.Body}"
                   Text="{Binding Value, ElementName=Roundness, StringFormat={}{0:0}%}"/>
        <Slider x:Name="Roundness" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="OnChanged"
                AutomationProperties.Name="Corner roundness"/>
      </DockPanel>

      <!-- Colour -->
      <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,24,0,8" Text="Colour"/>
      <WrapPanel x:Name="Swatches"/>
      <DockPanel Margin="0,8,0,0">
        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Content="More colours…" Click="OnMoreColours" Margin="8,0,0,0"/>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,8,0" Text="Hex"/>
        <TextBox x:Name="Hex" MaxLength="7" LostFocus="OnHexCommitted" KeyDown="OnHexKey" AutomationProperties.Name="Colour hex code"/>
      </DockPanel>
      <TextBlock x:Name="HexError" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="0,4,0,0"
                 Visibility="Collapsed" Text="Use a colour code like #F6F0FF."/>

      <!-- Transparency -->
      <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,24,0,8" Text="Opacity"/>
      <DockPanel>
        <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Width="72" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Text.Body}"/>
        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="OnChanged"
                AutomationProperties.Name="Dock opacity"/>
      </DockPanel>
      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                 Text="At 0% the dock itself is invisible and only your icons show."/>
      <CheckBox x:Name="Outline" Margin="0,12,0,0" Content="Thin outline around the dock" Checked="OnChanged" Unchecked="OnChanged"/>
    </StackPanel>
  </DockPanel>
</Window>
