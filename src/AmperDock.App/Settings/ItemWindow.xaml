<Window x:Class="AmperDock.App.Settings.ItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit dock item" Width="600" SizeToContent="Height" MinHeight="420" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Sans}" FontSize="{StaticResource Type.Body.Size}"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}">
  <!-- Edit one dock item: its name, what it opens, how it starts, and its icon. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}"
            Background="{DynamicResource Brush.Surface}" Padding="24,12">
      <DockPanel>
        <TextBlock x:Name="Error" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330"
                   Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Danger}"
                   AutomationProperties.LiveSetting="Assertive"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Btn.Secondary}" Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
          <Button Style="{StaticResource Btn.Primary}" Content="Save" IsDefault="True" Click="OnSave"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="24,20,24,24">
        <!-- header: the icon as it will look, and the name -->
        <DockPanel>
          <Border DockPanel.Dock="Left" Width="88" Height="88" CornerRadius="20" Margin="0,0,18,0"
                  Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Image x:Name="IconPreview" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="Icon preview"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Text.Caption}" Text="Name" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" AutomationProperties.Name="Name" MaxLength="120"/>
            <TextBlock x:Name="KindText" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
          </StackPanel>
        </DockPanel>

        <!-- what it opens -->
        <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,24,0,4" Text="Opens"/>
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="An app, file or folder on this PC, or a web address."/>
        <TextBox x:Name="TargetBox" AutomationProperties.Name="Location it opens" TextChanged="OnTargetChanged"/>
        <WrapPanel Margin="0,8,0,0">
          <Button Style="{StaticResource Btn.Secondary}" Content="Choose a file or app…" Click="OnBrowseFile" Margin="0,0,8,0"/>
          <Button Style="{StaticResource Btn.Secondary}" Content="Choose a folder…" Click="OnBrowseFolder" Margin="0,0,8,0"/>
          <Button x:Name="ShowButton" Style="{StaticResource Btn.Ghost}" Content="Show in File Explorer" Click="OnShow"/>
        </WrapPanel>

        <!-- program options -->
        <StackPanel x:Name="ProgramPanel">
          <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,24,0,4" Text="Starting the app"/>
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,4" Text="Extra options (optional)"/>
          <TextBox x:Name="ArgsBox" AutomationProperties.Name="Extra options passed to the app"/>
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,4" Text="Start in folder (optional)"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Content="Choose…" Click="OnBrowseStartIn" Margin="8,0,0,0"/>
            <TextBox x:Name="StartInBox" AutomationProperties.Name="Start in folder"/>
          </DockPanel>
          <CheckBox x:Name="AdminBox" Margin="0,14,0,0" Content="Run as administrator (Windows will ask each time)"/>
          <CheckBox x:Name="MultipleBox" Margin="0,8,0,0" Content="Open a new window on every click, instead of switching to the open one"/>
        </StackPanel>

        <!-- icon -->
        <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,24,0,4" Text="Icon"/>
        <TextBlock x:Name="IconSource" Style="{StaticResource Text.Caption}" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <WrapPanel>
          <Button Style="{StaticResource Btn.Primary}" Content="Choose an AmperDock icon…" Click="OnIconLibrary" Margin="0,0,8,8"/>
          <Button Style="{StaticResource Btn.Secondary}" Content="Use a picture or .ico…" Click="OnIconImage" Margin="0,0,8,8"/>
          <Button Style="{StaticResource Btn.Secondary}" Content="Pick from an app or DLL…" Click="OnIconPick" Margin="0,0,8,8"/>
          <Button x:Name="ResetIconButton" Style="{StaticResource Btn.Ghost}" Content="Use the default icon" Click="OnIconReset" Margin="0,0,0,8"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
