<Window x:Class="AmperDock.App.Settings.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add an app" Width="520" Height="640" MinWidth="380" MinHeight="360" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Sans}" FontSize="{StaticResource Type.Body.Size}"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}">
  <!-- Every app in Start → All apps (Store apps too), with a search box. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}"
            Background="{DynamicResource Brush.Surface}" Padding="24,12">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Ghost}" Content="Browse for a file instead…" Click="OnBrowse"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Btn.Secondary}" Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
          <Button x:Name="AddButton" Style="{StaticResource Btn.Primary}" Content="Add" IsDefault="True" IsEnabled="False" Click="OnAdd"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Margin="24,20,24,12">
      <TextBlock Style="{StaticResource Text.Title}" Text="Add an app"/>
      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,12" TextWrapping="Wrap"
                 Text="Pick one or more (hold Ctrl). Store apps work here too."/>
      <TextBox x:Name="SearchBox" AutomationProperties.Name="Search apps" TextChanged="OnSearch"/>
    </StackPanel>

    <Grid Margin="24,0,24,12">
      <ListBox x:Name="AppList" SelectionMode="Extended" SelectionChanged="OnSelection" MouseDoubleClick="OnDoubleClick"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Apps">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="0"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="2,3" AutomationProperties.Name="{Binding Name}">
              <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,12,0"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" VerticalAlignment="Center" Margin="8,0,0,0"
                         Style="{StaticResource Text.Caption}"/>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="Status" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                 Style="{StaticResource Text.Muted}" Text="Finding your apps…" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
  </DockPanel>
</Window>
