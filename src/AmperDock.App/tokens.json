{
  "_about": "AmperDock design tokens, used by both the WPF dialogs (Tokens.xaml is generated from this file) and the dock renderer (read at startup by AmperDock.Render). An original lilac/plum palette, (c) Ampersite LLC.",
  "color": {
    "light": {
      "bg": "#FBF8FF",
      "surface": "#F3ECFD",
      "surface-raised": "#FFFFFF",
      "border": "#E2D6F5",
      "border-input": "#8A76AE",
      "text": "#2A1F3D",
      "text-muted": "#5F5277",
      "accent": "#7444D6",
      "accent-hover": "#6334C4",
      "accent-soft": "#EBE0FF",
      "accent-text": "#6334C4",
      "on-accent": "#FFFFFF",
      "focus-ring": "#7444D6",
      "danger": "#B8283F",
      "danger-soft": "#FDE7EB",
      "success": "#1F7350",
      "success-soft": "#E1F5EB",
      "warning": "#8A5800",
      "warning-soft": "#FFF1D6",
      "blush": "#F4A6C8",
      "tooltip-bg": "#2A1F3D",
      "tooltip-text": "#FFFFFF"
    },
    "dark": {
      "bg": "#18121F",
      "surface": "#221A2E",
      "surface-raised": "#2C223B",
      "border": "#3C3052",
      "border-input": "#8F7DB3",
      "text": "#F4EFFC",
      "text-muted": "#BBAFD3",
      "accent": "#B497FF",
      "accent-hover": "#C6AFFF",
      "accent-soft": "#33274A",
      "accent-text": "#C6AFFF",
      "on-accent": "#1A1026",
      "focus-ring": "#C6AFFF",
      "danger": "#FF8FA3",
      "danger-soft": "#3D1C26",
      "success": "#7ED9AE",
      "success-soft": "#173226",
      "warning": "#F5C46A",
      "warning-soft": "#3A2C12",
      "blush": "#E58BB5",
      "tooltip-bg": "#F4EFFC",
      "tooltip-text": "#2A1F3D"
    }
  },
  "pairs": [
    ["light-text", "light-bg"], ["light-text", "light-surface"], ["light-text", "light-surface-raised"],
    ["light-text-muted", "light-bg"], ["light-text-muted", "light-surface"], ["light-text-muted", "light-surface-raised"],
    ["light-text", "light-accent-soft"], ["light-accent-text", "light-accent-soft"],
    ["light-on-accent", "light-accent"], ["light-on-accent", "light-accent-hover"],
    ["light-accent-text", "light-bg"], ["light-accent-text", "light-surface"], ["light-accent-text", "light-surface-raised"],
    ["light-danger", "light-bg"], ["light-danger", "light-danger-soft"],
    ["light-success", "light-bg"], ["light-success", "light-success-soft"],
    ["light-warning", "light-bg"], ["light-warning", "light-warning-soft"],
    ["light-tooltip-text", "light-tooltip-bg"],
    ["light-border-input", "light-bg", "ui"], ["light-border-input", "light-surface-raised", "ui"],
    ["light-focus-ring", "light-bg", "ui"], ["light-focus-ring", "light-surface", "ui"],
    ["light-accent", "light-surface-raised", "ui"],

    ["dark-text", "dark-bg"], ["dark-text", "dark-surface"], ["dark-text", "dark-surface-raised"],
    ["dark-text-muted", "dark-bg"], ["dark-text-muted", "dark-surface"], ["dark-text-muted", "dark-surface-raised"],
    ["dark-text", "dark-accent-soft"], ["dark-accent-text", "dark-accent-soft"],
    ["dark-on-accent", "dark-accent"], ["dark-on-accent", "dark-accent-hover"],
    ["dark-accent-text", "dark-bg"], ["dark-accent-text", "dark-surface"], ["dark-accent-text", "dark-surface-raised"],
    ["dark-danger", "dark-bg"], ["dark-danger", "dark-danger-soft"],
    ["dark-success", "dark-bg"], ["dark-success", "dark-success-soft"],
    ["dark-warning", "dark-bg"], ["dark-warning", "dark-warning-soft"],
    ["dark-tooltip-text", "dark-tooltip-bg"],
    ["dark-border-input", "dark-bg", "ui"], ["dark-border-input", "dark-surface-raised", "ui"],
    ["dark-focus-ring", "dark-bg", "ui"], ["dark-focus-ring", "dark-surface", "ui"],
    ["dark-accent", "dark-surface-raised", "ui"]
  ],
  "font": {
    "sans": "Nunito",
    "sans_fallback": "Segoe UI Variable, Segoe UI",
    "mono": "Cascadia Mono, Consolas",
    "_license": "Nunito is SIL OFL 1.1 and is bundled in the app (variable TTF). Cascadia Mono ships with Windows Terminal and is OFL; falls back to Consolas."
  },
  "type": {
    "caption": {"size": 12, "line": 16, "weight": 600},
    "body":    {"size": 14, "line": 20, "weight": 500},
    "body-strong": {"size": 14, "line": 20, "weight": 700},
    "subtitle": {"size": 16, "line": 22, "weight": 700},
    "title":   {"size": 20, "line": 28, "weight": 800},
    "display": {"size": 28, "line": 34, "weight": 800},
    "_note": "Windows dialogs are dense, so body is 14 (the Fluent default), not 16. Nunito runs small, so weights are a notch heavier than usual."
  },
  "space": [0, 2, 4, 8, 12, 16, 20, 24, 32, 40, 48],
  "radius": {"sm": 6, "md": 10, "lg": 16, "xl": 24, "pill": 999},
  "shadow": {
    "card":  {"blur": 6,  "y": 2, "opacity": 0.08, "color": "#2A1F3D"},
    "pop":   {"blur": 24, "y": 8, "opacity": 0.18, "color": "#2A1F3D"},
    "dock":  {"blur": 28, "y": 6, "opacity": 0.22, "color": "#2A1F3D"}
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "ease": [0.2, 0.8, 0.2, 1],
    "boop": [0.34, 1.56, 0.64, 1],
    "_boop": "a small overshoot ease for the cute moments (insert, launch, mascot). Use it sparingly; settings windows use plain ease",
    "magnify_spring": {"stiffness": 420, "damping": 32},
    "reduced_motion": "when Windows 'Animation effects' is off: no bounce, no overshoot, magnify still works but is instant-following, durations go to 0"
  },
  "dock": {
    "_about": "Defaults for the built-in 'Lilac' theme. Theme packs override them in theme.json",
    "icon_size": 48,
    "icon_size_min": 16,
    "icon_size_max": 256,
    "magnified_size": 80,
    "magnify_range_icons": 2.5,
    "icon_spacing": 8,
    "padding": {"x": 12, "y": 10},
    "radius": 22,
    "background": {"light": "#F6F0FFC7", "dark": "#221A2EC7", "_note": "#RRGGBBAA, 78% alpha over blur/acrylic when available, solid fallback at 96%"},
    "highlight_top": {"light": "#FFFFFF99", "dark": "#FFFFFF1A"},
    "outline": {"light": "#E2D6F5", "dark": "#3C3052"},
    "indicator": {"shape": "paw", "size": 24, "gap": 2, "color": "accent", "focused_color": "blush", "group_max_dots": 3},
    "label": {"bg": "tooltip-bg", "text": "tooltip-text", "radius": "pill", "padding": {"x": 10, "y": 4}, "offset": 10, "type": "body-strong"},
    "separator": {"shape": "dots", "color": "border", "width": 4, "gap": 4}
  }
}
