<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AmperDock</AssemblyName>
    <RootNamespace>AmperDock.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AmperDock.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>AmperDock</Product>
    <Company>AmperLabs LLC</Company>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF's Fluent ThemeMode is still marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- Mochi peeks, for the AmperDock window's header -->
    <Resource Include="Assets\AmperDock.png" />
    <!-- Mochi's poses for the Mochi widget (made by replica/tools/build_mochi.py) -->
    <Resource Include="Assets\Mochi\*.png" />
    <!-- her post, bowl and house, and her scenes with them (replica/tools/build_mochi_things.py) -->
    <Resource Include="Assets\Mochi\Things\*.png;Assets\Mochi\Things\things.json" />
    <!-- Mochi's Pals from Racing for Pi (replica/tools/build_pals.py) -->
    <Resource Include="Assets\Pals\**\*.png" />
    <!-- her purrs and meows: real recordings, played from files (see Sounds\CREDITS.txt) -->
    <Content Include="Assets\Mochi\Sounds\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tokens.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- generated by tools/build_lookpacks.py -->
    <Content Include="LookPacks\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- generated by tools/build_dockthemes.py -->
    <Content Include="DockThemes\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AmperDock.Core\AmperDock.Core.csproj" />
    <ProjectReference Include="..\AmperDock.Shell\AmperDock.Shell.csproj" />
    <ProjectReference Include="..\AmperDock.Render\AmperDock.Render.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
