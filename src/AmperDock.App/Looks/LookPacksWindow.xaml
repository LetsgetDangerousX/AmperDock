<Window x:Class="AmperDock.App.Looks.LookPacksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Look packs" Width="820" Height="780" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Sans}" FontSize="{StaticResource Type.Body.Size}"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}"
            Background="{DynamicResource Brush.Surface}" Padding="24,12">
      <DockPanel>
        <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Text="Changes apply right away. Everything here can be undone."/>
        <Button Style="{StaticResource Btn.Primary}" HorizontalAlignment="Right" Content="Done" IsCancel="True" IsDefault="True" Click="OnDone"/>
      </DockPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="28,22,28,28">
        <TextBlock Style="{StaticResource Text.Display}" Text="Look packs"/>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                   Text="Match your whole desktop to your dock: a whole theme at once, or cursors, a trail and folder icons one by one."/>

        <!-- theme packs -->
        <TextBlock Style="{StaticResource Text.Title}" Margin="0,28,0,4" Text="Theme packs"/>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                   Text="A wallpaper with a matching dock, cursors, trail and folder icons. Pick one, choose what to change, and apply. Undo puts everything back."/>
        <WrapPanel x:Name="PackCards"/>
        <Border x:Name="PackPanel" Margin="0,4,0,0" Padding="16,14" CornerRadius="14" BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.SurfaceRaised}">
          <StackPanel>
            <TextBlock x:Name="PackTitle" Style="{StaticResource Text.Subtitle}"/>
            <TextBlock x:Name="PackBlurb" Style="{StaticResource Text.Muted}" Margin="0,2,0,10" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource Text.BodyStrong}" Margin="0,0,0,6" Text="What to change"/>
            <WrapPanel>
              <CheckBox x:Name="PartWallpaper" Content="Wallpaper" IsChecked="True" Margin="0,0,18,6"/>
              <CheckBox x:Name="PartDock" Content="Dock theme (all your docks)" IsChecked="True" Margin="0,0,18,6"/>
              <CheckBox x:Name="PartCursors" Content="Cursors" IsChecked="True" Margin="0,0,18,6"/>
              <CheckBox x:Name="PartTrail" Content="Cursor trail" IsChecked="True" Margin="0,0,18,6"/>
              <CheckBox x:Name="PartFolders" Content="Folder icons" IsChecked="True" Margin="0,0,18,6"/>
            </WrapPanel>
            <TextBlock x:Name="FoldersNote" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Folder icons go on Documents, Downloads, Pictures, Music and Videos, the folders on your docks, and any you've already customised."/>
            <StackPanel x:Name="SlideshowChoice" Margin="0,4,0,0">
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                         Text="You have a wallpaper slideshow running. Setting a wallpaper stops it (Undo starts it again)."/>
              <RadioButton x:Name="WallSet" GroupName="wall" Content="Set this wallpaper" IsChecked="True" Margin="0,0,0,4"/>
              <RadioButton x:Name="WallAdd" GroupName="wall" Content="Add it to my slideshow instead"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="ApplyPackButton" Style="{StaticResource Btn.Primary}" Click="OnApplyPack"/>
              <Button x:Name="UndoPackButton" Style="{StaticResource Btn.Secondary}" Margin="10,0,0,0" Content="Undo theme pack" Click="OnUndoPack"/>
              <TextBlock x:Name="PackStatus" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="320"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- cursors -->
        <TextBlock Style="{StaticResource Text.Title}" Margin="0,28,0,4" Text="Cursors"/>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,12"
                   Text="Changes your pointer and link hand everywhere in Windows. Your own cursors are saved first, so you can always go back."/>
        <WrapPanel x:Name="CursorCards"/>

        <!-- trail -->
        <TextBlock Style="{StaticResource Text.Title}" Margin="0,28,0,4" Text="Cursor trail"/>
        <TextBlock x:Name="TrailNote" Style="{StaticResource Text.Muted}" Margin="0,0,0,12"
                   Text="Little things that follow your pointer. Clicks go straight through them, and they pause during fullscreen games."/>
        <WrapPanel x:Name="TrailCards"/>

        <!-- folder icons -->
        <TextBlock Style="{StaticResource Text.Title}" Margin="0,28,0,4" Text="Folder icons"/>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,12"
                   Text="Pick an icon, then choose the folders to give it to. Folders on your dock update too."/>
        <WrapPanel x:Name="FolderCards"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="ApplyFolderButton" Style="{StaticResource Btn.Primary}" Content="Choose folders…" Click="OnApplyFolder"/>
          <TextBlock x:Name="FolderStatus" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="12" BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.SurfaceRaised}">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Every folder on this PC"/>
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,8"
                       Text="Gives every folder the chosen icon, for everyone who uses this PC. Windows asks for permission first, and Undo puts the usual icon back."/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="EverywhereButton" Style="{StaticResource Btn.Secondary}" Click="OnEverywhere"/>
              <Button x:Name="EverywhereUndo" Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0" Content="Put back the usual folder icon" Click="OnEverywhereUndo"/>
              <TextBlock x:Name="EverywhereStatus" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="300"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,20,0,8" Text="Folders you've customised"/>
        <StackPanel x:Name="FolderList"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
