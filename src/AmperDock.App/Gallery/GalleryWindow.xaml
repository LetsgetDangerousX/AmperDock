<Window x:Class="AmperDock.App.Gallery.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AmperDock.App.Gallery"
        Title="AmperDock developer tool: component gallery" Width="900" Height="760" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Sans}" FontSize="{StaticResource Type.Body.Size}"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}">
  <!-- Every primitive from replica/design/components.md, in each state, so a token change can be checked in one place. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,24,32,48" MaxWidth="820">

      <Grid>
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Display}" Text="Component gallery"/>
          <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                     Text="A developer test page, not settings: the building blocks of every AmperDock window, shown in every state. Nothing here saves."/>
        </StackPanel>
        <Button x:Name="ThemeToggle" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Content="Switch to dark" Click="ToggleTheme"/>
      </Grid>

      <!-- Type -->
      <TextBlock Style="{StaticResource Text.Title}" Margin="0,32,0,8" Text="Type"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Display}" Text="Display 28 / 800"/>
          <TextBlock Style="{StaticResource Text.Title}" Text="Title 20 / 800"/>
          <TextBlock Style="{StaticResource Text.Subtitle}" Text="Subtitle 16 / 700"/>
          <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Body strong 14 / 700"/>
          <TextBlock Style="{StaticResource Text.Body}" Text="Body 14 / 500. Settings help text and labels use this size."/>
          <TextBlock Style="{StaticResource Text.Muted}" Text="Muted body. For descriptions under a setting."/>
          <TextBlock Style="{StaticResource Text.Caption}" Text="Caption 12 / 600"/>
        </StackPanel>
      </Border>

      <!-- Buttons -->
      <TextBlock Style="{StaticResource Text.Title}" Margin="0,32,0,8" Text="Buttons"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <WrapPanel>
            <Button Style="{StaticResource Btn.Primary}" Content="Primary" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn.Secondary}" Content="Secondary" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn.Ghost}" Content="Ghost" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn.Danger}" Content="Remove" Margin="0,0,8,8"/>
          </WrapPanel>
          <WrapPanel>
            <Button Style="{StaticResource Btn.Primary}" Content="Disabled" IsEnabled="False" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn.Secondary}" Content="Disabled" IsEnabled="False" Margin="0,0,8,8"/>
            <Button Style="{StaticResource Btn.Primary}" Margin="0,0,8,8" MinHeight="40" Padding="20,0" Content="Large primary"/>
            <Button Style="{StaticResource Btn.Secondary}" Margin="0,0,8,8" MinHeight="28" Padding="10,0" FontSize="12" Content="Small"/>
          </WrapPanel>
          <TextBlock Style="{StaticResource Text.Caption}" Text="Hover, press and Tab to each one. The focus ring is 2px with a 2px gap."/>
        </StackPanel>
      </Border>

      <!-- Inputs -->
      <TextBlock Style="{StaticResource Text.Title}" Margin="0,32,0,8" Text="Inputs"/>
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Label"/>
            <TextBox Margin="0,4,0,0" Text="Notepad"/>
            <TextBlock Style="{StaticResource Text.BodyStrong}" Margin="0,16,0,0" Text="Target"/>
            <TextBox x:Name="BadPath" Margin="0,4,0,0" Text="C:\Programs\gone.exe" BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="2"/>
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="0,4,0,0"
                       Text="Can't find this file. It may have been moved."/>
            <TextBlock Style="{StaticResource Text.BodyStrong}" Margin="0,16,0,0" Text="Run"/>
            <ComboBox Margin="0,4,0,0" SelectedIndex="0">
              <ComboBoxItem Content="Normal window"/>
              <ComboBoxItem Content="Minimized"/>
              <ComboBoxItem Content="Maximized"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <CheckBox Content="Magnify icons on hover" IsChecked="True"/>
            <CheckBox Content="Show labels on hover" IsChecked="True" Margin="0,8,0,0"/>
            <CheckBox Content="Reflections" Margin="0,8,0,0"/>
            <CheckBox Content="Lock items (disabled example)" IsEnabled="False" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource Text.BodyStrong}" Margin="0,16,0,0" Text="Icon size"/>
            <DockPanel Margin="0,4,0,0">
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Body}" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                         Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0} px}"/>
              <Slider x:Name="SizeSlider" Minimum="16" Maximum="256" Value="48" IsSnapToTickEnabled="True" TickFrequency="4"
                      AutomationProperties.Name="Icon size"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Text.BodyStrong}" Margin="0,16,0,0" Text="Hotkey"/>
            <local:HotkeyBox Margin="0,4,0,0"/>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Text="Click, then press a key combination. Esc cancels."/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Menus and toasts -->
      <TextBlock Style="{StaticResource Text.Title}" Margin="0,32,0,8" Text="Menu and toast"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Button Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left" Content="Right-click or click me for a menu" Click="ShowMenu">
            <Button.ContextMenu>
              <ContextMenu x:Name="SampleMenu">
                <MenuItem Header="Open"/>
                <MenuItem Header="Properties" InputGestureText="Alt+Enter"/>
                <MenuItem Header="Show labels" IsCheckable="True" IsChecked="True"/>
                <Separator/>
                <MenuItem Header="Remove from dock"/>
                <MenuItem Header="Lock items (disabled)" IsEnabled="False"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Border Margin="0,16,0,0" HorizontalAlignment="Left" Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" Padding="14,10">
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity=".18" Color="#2A1F3D"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource Img.Mochi}" Width="28" Height="28" VerticalAlignment="Center"/>
              <TextBlock Style="{StaticResource Text.Body}" Margin="10,0,16,0" VerticalAlignment="Center" Text="Removed Notepad from the dock."/>
              <Button Style="{StaticResource Btn.Ghost}" Content="Undo" MinWidth="0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Empty state -->
      <TextBlock Style="{StaticResource Text.Title}" Margin="0,32,0,8" Text="Empty state"/>
      <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
              CornerRadius="{StaticResource Radius.Lg}" Padding="20">
        <DockPanel>
          <Image DockPanel.Dock="Left" Source="{StaticResource Img.Mochi}" Width="56" Height="56" Margin="0,0,16,0"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Content="New alarm" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="No alarms yet."/>
            <TextBlock Style="{StaticResource Text.Muted}" Text="Mochi will nudge you when it's time."/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Chips -->
      <TextBlock Style="{StaticResource Text.Title}" Margin="0,32,0,8" Text="Palette"/>
      <WrapPanel x:Name="Swatches"/>
    </StackPanel>
  </ScrollViewer>
</Window>
